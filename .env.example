# Local development only. Copy to .env and never commit real secrets.
COMPOSE_PROJECT_NAME=recommendation-mlops

# Phase 8 — which image each job-group service resolves to (docker-compose.yml
# `image:` + `build:`). Leave both at default for local dev: `docker compose
# build` always builds fresh local images regardless of these vars.
# `docker compose pull` (no build) fetches `${DOCKERHUB_USERNAME}/mlops4rec-<job>:${IMAGE_TAG}`
# — set IMAGE_TAG to a git SHA Jenkins already built+pushed to run that exact
# version without building locally. See ADR 0005 / docs/modules/phase-8-*.md.
DOCKERHUB_USERNAME=local
IMAGE_TAG=dev

# Phase 8 — Jenkins CI (ADR 0005), infra/jenkins/docker-compose.jenkins.yml.
# Not started by `make up`/`make airflow-up` — see
# docs/modules/phase-8-cicd.md for the `docker compose -f
# infra/jenkins/docker-compose.jenkins.yml up -d --build` command.
JENKINS_PORT=8090
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=local_jenkins_password_change_me
# Re-used as DOCKERHUB_USERNAME above for `docker compose pull`. Set
# DOCKERHUB_TOKEN to a Docker Hub Access Token (Account Settings -> Security
# -> New Access Token), never your account password — see ADR 0005. Both
# stay empty here; the `dockerhub-creds` Jenkins credential
# (infra/jenkins/casc.yaml) is unusable until you set a real token, but
# every other stage in the Jenkinsfile (lint/test/model-smoke-test) works
# without it.
DOCKERHUB_TOKEN=

POSTGRES_IMAGE=postgres:17.6-bookworm
SOURCE_DB_NAME=recommendation
SOURCE_DB_USER=reco_app
SOURCE_DB_PASSWORD=local_source_password_change_me
SOURCE_DB_PORT=5433

CATALOG_DB_NAME=lakekeeper
CATALOG_DB_USER=lakekeeper
CATALOG_DB_PASSWORD=local_catalog_password_change_me
CATALOG_DB_PORT=5434
LAKEKEEPER_IMAGE=quay.io/lakekeeper/catalog:v0.12.1
LAKEKEEPER_PORT=8181
LAKEKEEPER_PG_ENCRYPTION_KEY=local-only-encryption-key-change-me-32chars
ICEBERG_WAREHOUSE_NAME=reco

MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local_minio_password_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1
ICEBERG_BUCKET=iceberg-warehouse
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
EXTRACT_STAGING_BUCKET=extract-staging
FEAST_OFFLINE_STORE_BUCKET=feast-offline-store

MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.12.0
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=local_mlflow_password_change_me
MLFLOW_DB_PORT=5435
MLFLOW_PORT=5000
MLFLOW_ALLOWED_HOSTS=localhost:5000,127.0.0.1:5000,mlflow:5000
# Phase 4 training-job (inside Docker network) — talks to the mlflow
# service above by its Compose DNS name.
MLFLOW_TRACKING_URI=http://mlflow:5000

# Phase 1 extract job (inside Docker network)
SOURCE_DB_DSN=postgresql://reco_app:local_source_password_change_me@source-db:5432/recommendation
# Internal SQL page size for the dlt incremental resource (not an audit
# unit — dlt owns the extraction cursor/state, see
# docs/decisions/0006-dlt-native-incremental-extract.md).
EXTRACT_PAGE_SIZE=1000
# Test-only: "<source>:<n>" (e.g. "interactions:5000") raises inside the
# resource generator after n rows, to prove a crash mid-extraction loses no
# data and duplicates nothing. Leave empty during normal runs.
EXTRACT_FAIL_AFTER_ROWS=
# Extract writes straight to MinIO (no local Parquet staging) — see
# docs/decisions/0003-extract-writes-directly-to-minio.md. Swap host to
# localhost when running outside Compose.
EXTRACT_S3_ENDPOINT=http://minio:9000
EXTRACT_S3_REGION=us-east-1

# Phase 2 transform job — Iceberg REST Catalog (Lakekeeper) + MinIO
# (inside Docker network; swap host to localhost when running outside Compose)
ICEBERG_CATALOG_URI=http://lakekeeper:8181/catalog
ICEBERG_S3_ENDPOINT=http://minio:9000
ICEBERG_S3_REGION=us-east-1

# Phase 3 feature store — Redis (online store) + Feast offline snapshot on
# MinIO (registry also lives there, see feature_repo/feature_store.yaml and
# docs/modules/phase-3-feature-store.md mục 2.4)
REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379
# Phase 5: plain redis-py clients (serving, jobs.candidates.similar_items)
# need an explicit host/port — feature_repo/feature_store.yaml hardcodes
# "redis:6379" for Feast's own client, unrelated to this.
REDIS_HOST=redis
FEAST_S3_ENDPOINT=http://minio:9000
FEAST_S3_REGION=us-east-1

# Phase 5 serving (FastAPI) + ui (Streamlit)
SERVING_PORT=8000
UI_PORT=8501
MODEL_POLL_INTERVAL_SECONDS=60
FALLBACK_REFRESH_INTERVAL_SECONDS=300

# Phase 6 orchestration — Airflow (LocalExecutor, local dev only)
AIRFLOW_IMAGE=apache/airflow:2.10.4-python3.12
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=local_airflow_password_change_me
AIRFLOW_PORT=8080
# Dev-only fixed Fernet key so restarting containers doesn't lose access to
# encrypted connections/variables — generate your own for anything beyond
# local development (`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
AIRFLOW_FERNET_KEY=OtkNHB44Oe-WP_N0P6CGuvzzS4u4x8dIbrrAGubDb40=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Phase 7 monitoring — operational (Prometheus/Grafana, docker-compose.override.yml)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=local_grafana_password_change_me

# Phase 7 monitoring — data/model quality (Evidently, jobs/monitoring/)
MONITORING_BASELINE_BUCKET=monitoring-baseline
MONITORING_REPORTS_BUCKET=monitoring-reports
